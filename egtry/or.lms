# Operations-research book QA (R45): pages with traced brute force and OR-Tools models solved in the page.
# Browser and HTTP evidence live in or-helper.mjs. All browser work is serialized with the other egtry suites.
let command = ["bash", "browser-lock.sh", "/tmp/browser-gate.lock", "node", "or-helper.mjs"];
for (i in range(0, args.len())) {
  push(command, args.get(i, ""));
}
let result = system(command);
println(result.get("stdout", ""));
println(result.get("stderr", ""));
exit(result.get("code", 1));
